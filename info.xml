<?xml version="1.0"?>
<extension key="au.com.agileware.volunteeractivities" type="module">
  <file>volunteeractivities</file>
  <name>Volunteer Activities</name>
  <description>A extension which shows the volunteer activities on contact page. This extension works only if CiviVolunteer extension is installed and enabled.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Agileware</author>
    <email>info@agileware.com.au</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">http://FIXME</url>
    <url desc="Documentation">http://FIXME</url>
    <url desc="Support">http://FIXME</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-09-12</releaseDate>
  <version>1.0.1</version>
  <develStage>alpha</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <civix>
    <namespace>CRM/Volunteeractivities</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <upgrader>CiviMix\Schema\Volunteeractivities\AutomaticUpgrader</upgrader>
</extension>
